/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [],
    "paths": {
      "@connected-ng/core": ["../../../dist/connected-ng/core"],
      "@connected-ng/core/*": ["../../../dist/connected-ng/core/*"]
